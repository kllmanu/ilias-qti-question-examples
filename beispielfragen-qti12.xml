    <item ident="il_1_qst_3" title="Kprim: Aussagen zur Erde" maxattempts="0">
        <qticomment>Beispielaufgabe zum Fragetyp Kprim Choice.</qticomment>
        <itemmetadata>
            <qtimetadata>
                <qtimetadatafield><fieldlabel>ILIAS_VERSION</fieldlabel><fieldentry>11.4 2026-09-03</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>QUESTIONTYPE</fieldlabel><fieldentry>assKprimChoice</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>AUTHOR</fieldlabel><fieldentry>Beispiel</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>points</fieldlabel><fieldentry>4</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>answer_type</fieldlabel><fieldentry>singleLine</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>option_label_setting</fieldlabel><fieldentry>right_wrong</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>custom_true_option_label</fieldlabel><fieldentry>Richtig</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>custom_false_option_label</fieldlabel><fieldentry>Falsch</fieldentry></qtimetadatafield>
            </qtimetadata>
        </itemmetadata>
        <presentation>
            <flow>
                <material>
                    <mattext texttype="text/plain">Beurteilen Sie jede Aussage zur Erde als richtig
                        oder falsch.</mattext>
                </material>
                <response_lid ident="MCMR" rcardinality="Multiple">
                    <render_choice shuffle="No">
                        <response_label ident="0">
                            <material>
                                <mattext>Die Erde kreist um die Sonne.</mattext>
                            </material>
                        </response_label>
                        <response_label ident="1">
                            <material>
                                <mattext>Der Mond ist ein Stern.</mattext>
                            </material>
                        </response_label>
                        <response_label ident="2">
                            <material>
                                <mattext>Ein Jahr hat etwa 365 Tage.</mattext>
                            </material>
                        </response_label>
                        <response_label ident="3">
                            <material>
                                <mattext>Die Erde ist flach.</mattext>
                            </material>
                        </response_label>
                    </render_choice>
                </response_lid>
            </flow>
        </presentation>
        <resprocessing>
            <outcomes>
                <decvar varname="SCORE" vartype="Decimal" defaultval="0" minvalue="0" maxvalue="4"/>
            </outcomes>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="0">1</varequal>
                </conditionvar>
            </respcondition>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="1">0</varequal>
                </conditionvar>
            </respcondition>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="2">1</varequal>
                </conditionvar>
            </respcondition>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="3">0</varequal>
                </conditionvar>
            </respcondition>
        </resprocessing>
    </item>

