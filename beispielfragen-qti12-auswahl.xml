<?xml version="1.0" encoding="UTF-8"?>
<questestinterop>
    <item ident="il_1_qst_1" title="01 - Single Choice: Hauptstadt" maxattempts="0">
        <qticomment>Beispielaufgabe zum Fragetyp Single Choice.</qticomment>
        <itemmetadata>
            <qtimetadata>
                <qtimetadatafield><fieldlabel>ILIAS_VERSION</fieldlabel><fieldentry>11.4 2026-09-03</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>QUESTIONTYPE</fieldlabel><fieldentry>assSingleChoice</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>AUTHOR</fieldlabel><fieldentry>Copilot</fieldentry></qtimetadatafield>
            </qtimetadata>
        </itemmetadata>
        <presentation>
            <flow>
                <material>
                    <mattext texttype="text/plain">Was ist die Hauptstadt von Frankreich?</mattext>
                </material>
                <response_lid ident="MCSR" rcardinality="Single">
                    <render_choice shuffle="No">
                        <response_label ident="A">
                            <material>
                                <mattext>Paris</mattext>
                            </material>
                        </response_label>
                        <response_label ident="B">
                            <material>
                                <mattext>Lyon</mattext>
                            </material>
                        </response_label>
                        <response_label ident="C">
                            <material>
                                <mattext>Marseille</mattext>
                            </material>
                        </response_label>
                    </render_choice>
                </response_lid>
            </flow>
        </presentation>
        <resprocessing>
            <outcomes>
                <decvar/>
            </outcomes>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="MCSR">A</varequal>
                </conditionvar>
                <setvar action="Add">1</setvar>
            </respcondition>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="MCSR">B</varequal>
                </conditionvar>
                <setvar action="Add">0</setvar>
            </respcondition>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="MCSR">C</varequal>
                </conditionvar>
                <setvar action="Add">0</setvar>
            </respcondition>
        </resprocessing>
    </item>

    <item ident="il_1_qst_2" title="02 - Multiple Choice: Primzahlen" maxattempts="0">
        <qticomment>Beispielaufgabe zum Fragetyp Multiple Choice.</qticomment>
        <itemmetadata>
            <qtimetadata>
                <qtimetadatafield><fieldlabel>ILIAS_VERSION</fieldlabel><fieldentry>11.4 2026-09-03</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>QUESTIONTYPE</fieldlabel><fieldentry>assMultipleChoice</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>AUTHOR</fieldlabel><fieldentry>Copilot</fieldentry></qtimetadatafield>
            </qtimetadata>
        </itemmetadata>
        <presentation>
            <flow>
                <material>
                    <mattext texttype="text/plain">Welche Zahlen sind Primzahlen?</mattext>
                </material>
                <response_lid ident="MCMR" rcardinality="Multiple">
                    <render_choice shuffle="No">
                        <response_label ident="A">
                            <material>
                                <mattext>2</mattext>
                            </material>
                        </response_label>
                        <response_label ident="B">
                            <material>
                                <mattext>9</mattext>
                            </material>
                        </response_label>
                        <response_label ident="C">
                            <material>
                                <mattext>11</mattext>
                            </material>
                        </response_label>
                    </render_choice>
                </response_lid>
            </flow>
        </presentation>
        <resprocessing>
            <outcomes>
                <decvar/>
            </outcomes>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="MCMR">A</varequal>
                </conditionvar>
                <setvar action="Add">1</setvar>
            </respcondition>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="MCMR">B</varequal>
                </conditionvar>
                <setvar action="Add">0</setvar>
            </respcondition>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="MCMR">C</varequal>
                </conditionvar>
                <setvar action="Add">1</setvar>
            </respcondition>
        </resprocessing>
    </item>

    <item ident="il_1_qst_3" title="03 - Kprim: Aussagen zur Erde" maxattempts="0">
        <qticomment>Beispielaufgabe zum Fragetyp Kprim Choice.</qticomment>
        <itemmetadata>
            <qtimetadata>
                <qtimetadatafield><fieldlabel>ILIAS_VERSION</fieldlabel><fieldentry>11.4 2026-09-03</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>QUESTIONTYPE</fieldlabel><fieldentry>assKprimChoice</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>AUTHOR</fieldlabel><fieldentry>Copilot</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>points</fieldlabel><fieldentry>4</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>answer_type</fieldlabel><fieldentry>singleLine</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>option_label_setting</fieldlabel><fieldentry>right_wrong</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>custom_true_option_label</fieldlabel><fieldentry>Richtig</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>custom_false_option_label</fieldlabel><fieldentry>Falsch</fieldentry></qtimetadatafield>
            </qtimetadata>
        </itemmetadata>
        <presentation>
            <flow>
                <material>
                    <mattext texttype="text/plain">Beurteilen Sie jede Aussage zur Erde als richtig
                        oder falsch.</mattext>
                </material>
                <response_lid ident="MCMR" rcardinality="Multiple">
                    <render_choice shuffle="No">
                        <response_label ident="0">
                            <material>
                                <mattext>Die Erde kreist um die Sonne.</mattext>
                            </material>
                        </response_label>
                        <response_label ident="1">
                            <material>
                                <mattext>Der Mond ist ein Stern.</mattext>
                            </material>
                        </response_label>
                        <response_label ident="2">
                            <material>
                                <mattext>Ein Jahr hat etwa 365 Tage.</mattext>
                            </material>
                        </response_label>
                        <response_label ident="3">
                            <material>
                                <mattext>Die Erde ist flach.</mattext>
                            </material>
                        </response_label>
                    </render_choice>
                </response_lid>
            </flow>
        </presentation>
        <resprocessing>
            <outcomes>
                <decvar varname="SCORE" vartype="Decimal" defaultval="0" minvalue="0" maxvalue="4"/>
            </outcomes>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="0">1</varequal>
                </conditionvar>
            </respcondition>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="1">0</varequal>
                </conditionvar>
            </respcondition>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="2">1</varequal>
                </conditionvar>
            </respcondition>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="3">0</varequal>
                </conditionvar>
            </respcondition>
        </resprocessing>
    </item>

    

    

    <item ident="il_1_qst_6" title="06 - Lückentext: Wasser" maxattempts="0">
        <qticomment>Beispielaufgabe zum Fragetyp Lückentextfrage.</qticomment>
        <itemmetadata>
            <qtimetadata>
                <qtimetadatafield><fieldlabel>ILIAS_VERSION</fieldlabel><fieldentry>11.4 2026-09-03</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>QUESTIONTYPE</fieldlabel><fieldentry>assClozeTest</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>AUTHOR</fieldlabel><fieldentry>Copilot</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>question</fieldlabel><fieldentry>Wasser besteht aus Wasserstoff und Sauerstoff.</fieldentry></qtimetadatafield>
            </qtimetadata>
        </itemmetadata>
        <presentation>
            <flow>
                <material>
                    <mattext texttype="text/plain">Wasser besteht aus </mattext>
                </material>
                <response_str ident="gap_0" rcardinality="Single">
                    <render_fib fibtype="String" prompt="Box" columns="12" maxchars="12"/>
                </response_str>
                <material>
                    <mattext texttype="text/plain"> und Sauerstoff.</mattext>
                </material>
            </flow>
        </presentation>
        <resprocessing>
            <outcomes>
                <decvar/>
            </outcomes>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="gap_0">Wasserstoff</varequal>
                </conditionvar>
                <setvar action="Add">1</setvar>
            </respcondition>
        </resprocessing>
    </item>

    <item ident="il_1_qst_7" title="07 - Numerische Antwort: Umfang" maxattempts="0">
        <qticomment>Beispielaufgabe zum Fragetyp Numerische Antwort.</qticomment>
        <itemmetadata>
            <qtimetadata>
                <qtimetadatafield><fieldlabel>ILIAS_VERSION</fieldlabel><fieldentry>11.4 2026-09-03</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>QUESTIONTYPE</fieldlabel><fieldentry>assNumeric</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>AUTHOR</fieldlabel><fieldentry>Copilot</fieldentry></qtimetadatafield>
            </qtimetadata>
        </itemmetadata>
        <presentation>
            <flow>
                <material>
                    <mattext texttype="text/plain">Wie gross ist der Umfang eines Quadrats mit
                        Seitenlänge 5 cm? Geben Sie nur die Zahl ein.</mattext>
                </material>
                <response_num ident="NUM" rcardinality="Single" numtype="Decimal">
                    <render_fib fibtype="Decimal" maxchars="8"/>
                </response_num>
            </flow>
        </presentation>
        <resprocessing>
            <outcomes>
                <decvar/>
            </outcomes>
            <respcondition continue="Yes">
                <conditionvar>
                    <vargte respident="NUM">20</vargte>
                    <varlte respident="NUM">20</varlte>
                </conditionvar>
                <setvar action="Add">1</setvar>
            </respcondition>
        </resprocessing>
    </item>

    <item ident="il_1_qst_8" title="08 - Formelfrage: Rechnen mit Formeln" maxattempts="0">
        <qticomment>Beispielaufgabe zum Fragetyp Formel.</qticomment>
        <itemmetadata>
            <qtimetadata>
                <qtimetadatafield><fieldlabel>ILIAS_VERSION</fieldlabel><fieldentry>11.4 2026-09-03</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>QUESTIONTYPE</fieldlabel><fieldentry>assFormulaQuestion</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>AUTHOR</fieldlabel><fieldentry>Copilot</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>points</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>$r1</fieldlabel><fieldentry><![CDATA[a:10:{s:9:"precision";i:0;s:9:"tolerance";d:0;s:8:"rangemin";d:9;s:8:"rangemax";d:9;s:6:"points";d:1;s:7:"formula";s:3:"4+5";s:6:"rating";s:0:"";s:4:"unit";s:0:"";s:9:"unitvalue";s:0:"";s:11:"resultunits";a:0:{}}]]></fieldentry></qtimetadatafield>
            </qtimetadata>
        </itemmetadata>
        <presentation>
            <flow>
                <material>
                    <mattext texttype="text/plain">Berechnen Sie 4 + 5. Ergebnis: $r1</mattext>
                </material>
            </flow>
        </presentation>
    </item>

    <item ident="il_1_qst_9" title="09 - Begriffe benennen: Aggregatzustände" maxattempts="0">
        <qticomment>Beispielaufgabe zum Fragetyp Begriffe benennen.</qticomment>
        <itemmetadata>
            <qtimetadata>
                <qtimetadatafield><fieldlabel>ILIAS_VERSION</fieldlabel><fieldentry>11.4 2026-09-03</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>QUESTIONTYPE</fieldlabel><fieldentry>assTextSubset</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>AUTHOR</fieldlabel><fieldentry>Copilot</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>textrating</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>correctanswers</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>points</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield>
            </qtimetadata>
        </itemmetadata>
        <presentation>
            <flow>
                <material>
                    <mattext texttype="text/plain">Wie nennt man den gasförmigen Zustand von Wasser?</mattext>
                </material>
                <response_str ident="TEXTSUBSET_1" rcardinality="Single">
                    <render_fib fibtype="String" columns="20"/>
                </response_str>
            </flow>
        </presentation>
        <resprocessing>
            <outcomes>
                <decvar/>
                <decvar varname="matches" defaultval="0"/>
            </outcomes>
            <respcondition continue="Yes">
                <conditionvar>
                    <varsubset respident="TEXTSUBSET_1">Dampf</varsubset>
                </conditionvar>
                <setvar varname="matches" action="Add">1</setvar>
            </respcondition>
        </resprocessing>
    </item>

    <item ident="il_1_qst_10" title="10 - Anordnungsfrage vertikal: Planeten" maxattempts="0">
        <qticomment>Beispielaufgabe zum Fragetyp Anordnungsfrage: vertikal.</qticomment>
        <itemmetadata>
            <qtimetadata>
                <qtimetadatafield><fieldlabel>ILIAS_VERSION</fieldlabel><fieldentry>11.4 2026-09-03</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>QUESTIONTYPE</fieldlabel><fieldentry>assOrderingQuestion</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>AUTHOR</fieldlabel><fieldentry>Copilot</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>points</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield>
            </qtimetadata>
        </itemmetadata>
        <presentation>
            <flow>
                <material>
                    <mattext texttype="text/plain">Ordnen Sie die Planeten von der Sonne nach
                        aussen.</mattext>
                </material>
                <response_lid ident="OQT" rcardinality="Ordered" output="javascript">
                    <render_choice shuffle="Yes">
                        <response_label ident="2">
                            <material>
                                <mattext>Erde</mattext>
                            </material>
                        </response_label>
                        <response_label ident="0">
                            <material>
                                <mattext>Merkur</mattext>
                            </material>
                        </response_label>
                        <response_label ident="1">
                            <material>
                                <mattext>Mars</mattext>
                            </material>
                        </response_label>
                    </render_choice>
                </response_lid>
            </flow>
        </presentation>
        <resprocessing>
            <outcomes>
                <decvar/>
            </outcomes>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="OQT" index="2">0</varequal>
                </conditionvar>
                <setvar action="Add">1</setvar>
            </respcondition>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="OQT" index="0">1</varequal>
                </conditionvar>
                <setvar action="Add">1</setvar>
            </respcondition>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="OQT" index="1">2</varequal>
                </conditionvar>
                <setvar action="Add">1</setvar>
            </respcondition>
        </resprocessing>
    </item>

    

    <item ident="il_1_qst_12" title="12 - Zuordnungsfrage: Tier und Lebensraum" maxattempts="0">
        <qticomment>Beispielaufgabe zum Fragetyp Zuordnungsfrage.</qticomment>
        <itemmetadata>
            <qtimetadata>
                <qtimetadatafield><fieldlabel>ILIAS_VERSION</fieldlabel><fieldentry>11.4 2026-09-03</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>QUESTIONTYPE</fieldlabel><fieldentry>assMatchingQuestion</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>AUTHOR</fieldlabel><fieldentry>Copilot</fieldentry></qtimetadatafield>
            </qtimetadata>
        </itemmetadata>
        <presentation>
            <flow>
                <material>
                    <mattext texttype="text/plain">Ordnen Sie jedem Tier den passenden Lebensraum
                        zu.</mattext>
                </material>
                <response_grp ident="MQ" rcardinality="Multiple">
                    <render_choice shuffle="No">
                        <response_label ident="1" match_max="1" match_group="3,4">
                            <material>
                                <mattext>Frosch</mattext>
                            </material>
                        </response_label>
                        <response_label ident="2" match_max="1" match_group="3,4">
                            <material>
                                <mattext>Kamel</mattext>
                            </material>
                        </response_label>
                        <response_label ident="3">
                            <material>
                                <mattext>Teich</mattext>
                            </material>
                        </response_label>
                        <response_label ident="4">
                            <material>
                                <mattext>Wüste</mattext>
                            </material>
                        </response_label>
                    </render_choice>
                </response_grp>
            </flow>
        </presentation>
        <resprocessing>
            <outcomes>
                <decvar/>
            </outcomes>
            <respcondition continue="Yes">
                <conditionvar>
                    <varsubset respident="MQ">3,1</varsubset>
                </conditionvar>
                <setvar action="Add">1</setvar>
            </respcondition>
            <respcondition continue="Yes">
                <conditionvar>
                    <varsubset respident="MQ">4,2</varsubset>
                </conditionvar>
                <setvar action="Add">1</setvar>
            </respcondition>
        </resprocessing>
    </item>

    <item ident="il_1_qst_13" title="13 - Freitext eingeben: Energie sparen" maxattempts="0">
        <qticomment>Beispielaufgabe zum Fragetyp Freitext eingeben.</qticomment>
        <itemmetadata>
            <qtimetadata>
                <qtimetadatafield><fieldlabel>ILIAS_VERSION</fieldlabel><fieldentry>11.4 2026-09-03</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>QUESTIONTYPE</fieldlabel><fieldentry>assTextQuestion</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>AUTHOR</fieldlabel><fieldentry>Copilot</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>textrating</fieldlabel><fieldentry>0</fieldentry></qtimetadatafield>
                <qtimetadatafield><fieldlabel>matchcondition</fieldlabel><fieldentry>0</fieldentry></qtimetadatafield>
            </qtimetadata>
        </itemmetadata>
        <presentation>
            <flow>
                <material>
                    <mattext texttype="text/plain">Nennen Sie zwei Massnahmen, mit denen im Alltag
                        Energie gespart werden kann.</mattext>
                </material>
                <response_str ident="TEXT" rcardinality="Ordered">
                    <render_fib fibtype="String" rows="6" columns="80"/>
                </response_str>
            </flow>
        </presentation>
        <resprocessing scoremodel="HumanRater">
            <outcomes>
                <decvar varname="WritingScore" vartype="Integer" minvalue="0" maxvalue="2"/>
            </outcomes>
            <respcondition>
                <conditionvar>
                    <other>tutor_rated</other>
                </conditionvar>
            </respcondition>
        </resprocessing>
    </item>

    

    
</questestinterop>
